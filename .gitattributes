# 统一按 LF 存储，避免 Windows / macOS / Linux 之间的换行差异
* text=auto eol=lf

# 这两个必须是 LF，否则在 Linux/macOS 上无法执行
gradlew text eol=lf
*.sh text eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.jar binary
*.jks binary
*.keystore binary
*.apk binary
*.so binary
*.dex binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
