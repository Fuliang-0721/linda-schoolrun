APP_NAME=SchoolRun Shared Backend
APP_ENV=production
APP_VERSION=1.0.0
API_V1_PREFIX=/api
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
AUTO_CREATE_TABLES=true
SQL_ECHO=false
CORS_ALLOW_ORIGINS=

# 可选：直接指定数据库连接（留空则用下面的 MYSQL_* 配置）
# 本地开发（无 MySQL）可用 SQLite：DATABASE_URL=sqlite:///./dev.db
DATABASE_URL=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=schoolrun_shared
MYSQL_USER=schoolrun_app
MYSQL_PASSWORD=change_me
MYSQL_CHARSET=utf8mb4

ADMIN_USERNAME=admin
ADMIN_PUBLIC_ORIGIN=
ADMIN_PASSWORD=change_me_admin
ADMIN_SESSION_SECRET=change_me_session_secret
MOBILE_AUTH_SECRET=change_me_mobile_auth_secret
MOBILE_AUTH_MAX_AGE_SECONDS=2592000
AUTH_WRONG_PASSWORD_WINDOW_SECONDS=600
AUTH_WRONG_PASSWORD_MAX_ATTEMPTS=5
AUTH_WRONG_PASSWORD_FIRST_BAN_SECONDS=86400
AUTH_WRONG_DEVICE_MAX_ATTEMPTS=3
CLIENT_NOTICE_TITLE=使用说明
CLIENT_NOTICE_MESSAGE=本软件为开源软件，仅供学习交流，禁止盈利。
CLIENT_NOTICE_GROUP_NUMBER=
CLIENT_BILIBILI_TEXT=本软件由 Fuliang_teaseller 维护。
CLIENT_BILIBILI_URL=
CLIENT_KILL_SWITCH=false
CLIENT_KILL_SWITCH_MESSAGE=

# 自动更新：安装包存放目录（相对 backend 根）与对外下载前缀（生产交给 Nginx 静态托管）
APP_LOGS_DIR=app_logs
RELEASES_DIR=releases
RELEASE_PUBLIC_BASE_URL=
