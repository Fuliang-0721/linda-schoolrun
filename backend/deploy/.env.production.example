# 复制为 .env 后按提示修改；`docker compose up -d` 会读取它
# 注意：本文件不要提交到 Git（deploy/.env 已在忽略规则外，请自行确认）

# ============ 站点与证书 ============
# 有域名（且已完成 ICP 备案、80/443 可访问）时填域名，Caddy 会自动签 HTTPS
SITE_ADDRESS=app.example.com
# 证书到期提醒邮箱
ACME_EMAIL=you@example.com

# ============ 数据库 ============
MYSQL_ROOT_PASSWORD=改成强口令_root
MYSQL_DATABASE=schoolrun_shared
MYSQL_USER=schoolrun_app
MYSQL_PASSWORD=改成强口令_app

# ============ 应用 ============
APP_NAME=SchoolRun Shared Backend
APP_ENV=production
APP_VERSION=1.1.0
API_V1_PREFIX=/api
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
AUTO_CREATE_TABLES=true
SQL_ECHO=false
CORS_ALLOW_ORIGINS=
# 本地开发可指向 SQLite；生产留空，使用上面的 MYSQL_* 配置
DATABASE_URL=

# ============ 管理后台 ============
ADMIN_USERNAME=admin
ADMIN_PUBLIC_ORIGIN=https://app.example.com
ADMIN_PASSWORD=改成强口令_admin
ADMIN_SESSION_SECRET=改成32位以上随机串
MOBILE_AUTH_SECRET=改成32位以上随机串
MOBILE_AUTH_MAX_AGE_SECONDS=2592000
AUTH_WRONG_PASSWORD_WINDOW_SECONDS=600
AUTH_WRONG_PASSWORD_MAX_ATTEMPTS=5
AUTH_WRONG_PASSWORD_FIRST_BAN_SECONDS=86400
AUTH_WRONG_DEVICE_MAX_ATTEMPTS=3

# ============ 客户端公告与远程开关 ============
CLIENT_NOTICE_TITLE=使用说明
CLIENT_NOTICE_MESSAGE=本软件为开源软件，仅供学习交流，禁止盈利。
CLIENT_NOTICE_GROUP_NUMBER=
CLIENT_BILIBILI_TEXT=本软件由 Fuliang_teaseller 维护。
CLIENT_BILIBILI_URL=
CLIENT_KILL_SWITCH=false
CLIENT_KILL_SWITCH_MESSAGE=

# ============ 自动更新 ============
APP_LOGS_DIR=app_logs
RELEASES_DIR=releases
# 与 Caddyfile 的 /dl/ 对应；客户端拿到的下载地址基于它拼接
RELEASE_PUBLIC_BASE_URL=https://app.example.com/dl
